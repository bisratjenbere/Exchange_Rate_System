# Ethiopian Bank Exchange Rate Intelligence System - .gitignore

# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# ============================================================================
# Database & Data
# ============================================================================
# Database files (if using SQLite for dev/testing)
*.db
*.sqlite
*.sqlite3

# Database dumps (keep versioned backups only)
backups/*.sql
backups/*.sql.gz
!backups/README.md

# Logs (keep log directory structure, ignore content)
logs/*
!logs/.gitkeep

# ============================================================================
# Environment & Secrets
# ============================================================================
# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
secrets/

# ============================================================================
# IDEs and Editors
# ============================================================================
# VSCode
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
!.vscode/launch.json.example

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============================================================================
# OS Files
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ============================================================================
# Project-Specific
# ============================================================================
# Inspection scripts (temporary debug/exploration)
inspect_*.py

# Survey scripts (temporary reconnaissance)
survey_*.py

# Temporary data captures (keep evidence with timestamps)
temp/
tmp/
scratch/

# Browser automation artifacts
playwright-report/
test-results/

# Local development overrides
local_config.py
config.local.py

# Ad-hoc test files
test_adhoc_*.py
playground_*.py
debug_*.py

# ============================================================================
# Development Artifacts & Debug Scripts
# ============================================================================
# Backup files
*.backup
*.bak
*~

# Ad-hoc check/debug scripts
scripts/check_*.py

# Performance test artifacts
tests/performance/

