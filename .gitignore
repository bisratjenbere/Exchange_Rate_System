# Ethiopian Bank Exchange Rate Intelligence System - .gitignore

# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# C extensions
*.so

# Cache directories
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pylint.d/
.tox/
.nox/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
test-results/
.pytest_results/
junit/
.pytest-results/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# ============================================================================
# Database & Data
# ============================================================================
# Database files (if using SQLite for dev/testing)
*.db
*.sqlite
*.sqlite3

# Database dumps (keep versioned backups only)
backups/*.sql
backups/*.sql.gz
!backups/README.md

# Logs (keep log directory structure, ignore content)
logs/*
!logs/.gitkeep

# ============================================================================
# Environment & Secrets
# ============================================================================
# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
secrets/

# ============================================================================
# IDEs and Editors
# ============================================================================
# VSCode
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
!.vscode/launch.json.example

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

