[Unit]
Description=Ethiopian Bank Exchange Rate Collection
After=network-online.target postgresql@16-main.service
Wants=network-online.target postgresql@16-main.service

[Service]
Type=oneshot
User=bisru
WorkingDirectory=/home/bisru/Exchange_Rate_System
ExecStart=/usr/bin/python3 -m scheduler.run_job
StandardOutput=journal
StandardError=journal
# Exit code 1 = all sources failed; systemd marks the run as failed
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
