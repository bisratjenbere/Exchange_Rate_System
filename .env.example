# Ethiopian Bank Exchange Rate Intelligence System - Environment Variables

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/exchange_rates

# API Configuration
FLASK_ENV=development
FLASK_APP=api.app:app
API_PORT=5000

# Scheduler Configuration
COLLECTION_INTERVAL_MINUTES=60
MAX_CONCURRENT_COLLECTIONS=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/collection.log

# Timezone
TZ=Africa/Addis_Ababa

# Browser Automation (for sources requiring browser rendering)
# PLAYWRIGHT_BROWSER=chromium
# HEADLESS=true

# Rate Limiting (requests per minute per source)
REQUEST_RATE_LIMIT=10

# Timeout Configuration (seconds)
HTTP_TIMEOUT=30
BROWSER_TIMEOUT=60

# SSL Verification (override for specific sources with cert issues)
# Set via adapter configuration in seed_and_run.py
